PORT=3000
MONGODB_URI=mongodb://localhost:27017/mindconnect # Điều chỉnh URI MongoDB để kết nối với cơ sở dữ liệu của bạn
SKIP_DB_CONNECT=false
REQUIRE_MONGODB=false
# Lấy secret key JWT bằng lệnh sau trong terminal:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGIN=*
